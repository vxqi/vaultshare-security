<div class="card">
  <h1>Two-factor verification</h1>
  <p class="muted">Enter the 6-digit code from your authenticator app.</p>
  <% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
  <form method="POST" action="/login/mfa">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="token">Authentication code</label>
    <input type="text" id="token" name="token" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus autocomplete="one-time-code">
    <button type="submit">Verify</button>
  </form>
</div>