<div class="card">
  <h1>Log in</h1>
  <% if (registered) { %><div class="success-box" role="status">Account created. You can log in now.</div><% } %>
  <% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
  <form method="POST" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autocomplete="email">

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required autocomplete="current-password">

    <button type="submit">Log in</button>
  </form>

  <div style="display:flex; align-items:center; gap:12px; margin:20px 0; color:var(--muted, #8B96A5); font-size:0.85rem;">
    <div style="flex:1; height:1px; background:currentColor; opacity:0.25;"></div>
    <span>OR</span>
    <div style="flex:1; height:1px; background:currentColor; opacity:0.25;"></div>
  </div>

  <a href="/auth/google"
     style="display:flex; align-items:center; justify-content:center; gap:10px; width:100%; padding:10px 16px; border:1px solid var(--muted, #8B96A5); border-radius:6px; text-decoration:none; color:inherit; font-size:0.95rem;">
    <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z"/>
      <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.9v2.33A9 9 0 0 0 9 18z"/>
      <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.67 9c0-.59.1-1.16.28-1.7V4.97H.9A9 9 0 0 0 0 9c0 1.45.35 2.83.9 4.03l3.05-2.33z"/>
      <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .9 4.97l3.05 2.33C4.66 5.17 6.65 3.58 9 3.58z"/>
    </svg>
    <span>Continue with Google</span>
  </a>

  <p class="muted" style="margin-top:16px">Need an account? <a href="/register" style="color:var(--brass)">Register</a></p>
</div>