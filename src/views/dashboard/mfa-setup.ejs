<div class="card">
  <h1>Set up two-factor authentication</h1>
  <p class="muted">Scan this QR code with an authenticator app (Google Authenticator, Authy, 1Password, etc.), then enter the 6-digit code to confirm.</p>
  <% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
  <img src="<%= qrDataUrl %>" alt="MFA QR code" style="background:#fff;padding:12px;border-radius:8px;">
  <p class="muted">Can't scan? Enter this key manually: <code><%= secret %></code></p>
  <form method="POST" action="/settings/mfa/setup">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="token">Confirmation code</label>
    <input type="text" id="token" name="token" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code">
    <button type="submit">Confirm & enable</button>
  </form>
</div>